# ─── PayFast (custom integration) ───────────────────────────────────
#
# PAYFAST_ENV controls which credential set and gateway URL are used:
#   test → https://sandbox.payfast.co.za/eng/process
#   live → https://www.payfast.co.za/eng/process
#
# Passphrase must match PayFast dashboard → Settings → Security (exact spelling).
# Buyer email at checkout must NOT equal PAYFAST_MERCHANT_EMAIL.
#

# ─── Site (PayFast return/cancel URLs) ─────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://cardamomkitchen.co.za

# ─── PayFast ─────────────────────────────────────────────────────────────────
# Switch: test = sandbox.payfast.co.za | live = www.payfast.co.za
PAYFAST_ENV=live

